# PostgreSQL connection string
# Both preferred and alternative stacks share the same database
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# JWT signing secret — use a strong random string (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API port
# preferred-stack: 3001
# alternative-stack: 4001
PORT=3001
